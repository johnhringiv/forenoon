# Copy to .env (never commit it).
# Signs the rating links in each book. Generate with: openssl rand -hex 32
FORENOON_FEEDBACK_SECRET=
FORENOON_SMTP_PASSWORD=
# Claude API key from the Claude Console. The model chooses the articles: set this, or a model
# server below. Without either, a run falls back to newest first and the alert says so.
FORENOON_ANTHROPIC_API_KEY=
# Or a server that speaks the OpenAI API: Ollama, LM Studio, llama.cpp or vLLM on your
# network, or OpenAI itself. LAN is the connection's name: its models are then lan/<model id>
# on the Settings page, where the Test button checks it. More than one can be set, each under
# its own name. Only the address is needed (see docs/setup-deploy.md); with docker compose,
# also add the lines the compose file shows.
#FORENOON_LLM_LAN_URL=http://192.168.1.20:8080/v1
# If the server was started with a key:
#FORENOON_LLM_LAN_KEY=
# The tokens the server holds in one request, prompt and answer: what it is set to.
#FORENOON_LLM_LAN_CONTEXT=32768
# The answer limit, and the seconds to wait for one answer.
#FORENOON_LLM_LAN_OUTPUT=16384
#FORENOON_LLM_LAN_TIMEOUT=300
# Let the model reason first (off by default: slower, and no better picks in a test).
#FORENOON_LLM_LAN_REASONING=1
# A paid service on your network: count it toward the daily tokens.
#FORENOON_LLM_LAN_FREE=0
# Host folder holding the SQLite database and everything fetched.
# Must be writable by UID 1000: sudo chown -R 1000:1000 <folder>
FORENOON_HOST_DATA=/volume1/docker/forenoon
# Only if the folder must be owned by a different host user:
#PUID=1026
#PGID=100
# Also the time zone the delivery time on the Settings page is in.
TZ=America/New_York
# The mail server books and alerts are sent through (see docs/setup-email.md). The sender
# must be on Amazon's Approved Personal Document E-mail List. Example values are Resend's.
FORENOON_SMTP_HOST=smtp.resend.com
FORENOON_SMTP_PORT=587
# Only for a server that wants TLS from the start (port 465) rather than STARTTLS (587).
# FORENOON_SMTP_IMPLICIT_TLS=true   (true or false; false when left out)
FORENOON_SMTP_USERNAME=resend
FORENOON_SMTP_SENDER=forenoon@your-domain.example
# The largest message the server takes, in bytes. Resend accepts 40 MB after encoding.
#FORENOON_SMTP_MAX_MESSAGE_BYTES=38000000
# Public https address of the web pages (the tunnel's hostname, or your proxy's): where the
# rating links in each book point. Empty delivers without rating links.
FORENOON_PUBLIC_URL=
# Where you open the web pages, for the links in their emails (confirm an address, reset a
# password); usually the same address. They are sent through the mail server above.
FORENOON_WEB_URL=
# Ingress: "cloudflared" runs the Cloudflare Tunnel sidecar; route its public hostname to
# http://localhost:8081. Empty = bring your own reverse proxy, which reaches the pages on
# WEB_LISTEN. Add "browser" for subscriber sessions (see docs/setup-sessions.md).
COMPOSE_PROFILES=cloudflared
TUNNEL_TOKEN=
# Served over https: the session cookie is sent only that way, and a visit to the LAN address
# is redirected to FORENOON_WEB_URL. deploy.sh turns this on when TUNNEL_TOKEN is set; with
# docker compose, set it yourself.
#FORENOON_WEB_SECURE_COOKIES=true
# The header your proxy gives the client's address in, for the sign-in limits, and the
# addresses it is believed from. docker compose defaults to the tunnel's CF-Connecting-IP
# from 127.0.0.1, and deploy.sh does the same when TUNNEL_TOKEN is set. For your own proxy,
# for example: X-Forwarded-For from 192.168.1.1
#FORENOON_WEB_CLIENT_IP_HEADER=CF-Connecting-IP
#FORENOON_WEB_TRUSTED_PROXIES=127.0.0.1,::1
# The host port the web pages are published on, for your own proxy or the LAN. docker
# compose publishes them on 127.0.0.1:8081 by default; deploy.sh publishes none without it.
#WEB_LISTEN=8081
# A public demo: hostnames at which one reader's Newsstand, Archive and Sources are shown
# read-only to anyone, with no sign-in, as host=reader pairs. Route each hostname to the web
# pages as well (a second public hostname on the tunnel). Leave it out for an ordinary install.
#FORENOON_WEB_DEMO=alice.forenoon.example=alice,bob.forenoon.example=bob
# The public site: the hostname at which the project's landing page, built into the web
# program, is served. Route it to the web pages as well. Leave it out for an ordinary install.
#FORENOON_WEB_LANDING=forenoon.dev

# --- Images. Left out, docker compose builds them here; deploy.sh needs IMAGE and WEB_IMAGE.
# To follow CI (poll-deploy.sh, or poll-compose.sh for docker compose), use the GHCR tags.
# Image to run. With CI publishing to GHCR: ghcr.io/<owner>/<repo>:latest
#IMAGE=forenoon:local
# Optional: the browser that reads article pages signed in as you, for sites you subscribe
# to (see docs/setup-sessions.md). Sessions are saved on the web pages' Sources page. For
# docker compose, add "browser" to COMPOSE_PROFILES.
#BROWSER_IMAGE=ghcr.io/<owner>/<repo>-browser:latest
# The web pages' image. They are behind a login; create the first account after the first
# start with
#   docker exec -it forenoon-web forenoon-web add-user <id> --email <address>
#WEB_IMAGE=ghcr.io/<owner>/<repo>-web:latest
# Tunnel image. deploy.sh defaults to :latest and poll-deploy.sh follows it; pin a version
# here to opt out. docker compose defaults to a pinned version.
#CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
